# 早期拷贝残留的嵌套子工程，非本工程组成部分
realtime-platform/

# 测试报告（每次运行生成）
tests/report.json

# 运行态快照（工单/告警编号/告警上下文），启动时自动生成
data/runtime-state.json
data/runtime-state.json.tmp
data/runtime-state-*.json
data/runtime-state-*.tmp

# 台架实测输出（CSV/JSON/导出）
bench/out/*
!bench/out/.gitkeep
