{
  "name": "realtime-platform",
  "version": "1.0.0",
  "private": true,
  "description": "城轨受电弓碳滑板监测平台 1.0 —— 双包上报协议与告警运维闭环（论文技术全量落地）",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/run-tests.js",
    "test:store": "node tests/store.js",
    "test:int": "node tests/integration.js",
    "test:persist": "node tests/persistence.js",
    "test:auth": "node tests/auth.js",
    "test:media": "node tests/media.js",
    "test:e2e": "node tests/e2e.js",
    "test:all": "node tests/run-tests.js && node tests/store.js && node tests/smoke_routes.js && node tests/integration.js && node tests/persistence.js && node tests/auth.js && node tests/media.js && node tests/e2e.js",
    "verify": "node tests/run-tests.js && node tools/verify_seq.js && node tools/verify_maint.js && node tools/verify_latency.js && node tools/verify_rul.js && node tools/verify_alarm.js",
    "verify:seq": "node tools/verify_seq.js",
    "verify:latency": "node tools/verify_latency.js",
    "verify:alarm": "node tools/verify_alarm.js",
    "verify:rul": "node tools/verify_rul.js",
    "verify:maint": "node tools/verify_maint.js",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "plc-sim": "node plc-simulator.js",
    "plc-sim:anomaly": "node plc-simulator.js --anomaly temperature:high",
    "plc-sim:closedloop": "node plc-simulator.js --debug"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@kjgl77/datav-vue3": "^1.7.4",
    "@prisma/client": "^5.22.0",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "express": "^4.18.2",
    "modbus-serial": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.1",
    "pinia": "^3.0.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "prisma": "^5.22.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
