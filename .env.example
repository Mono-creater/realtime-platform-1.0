# ============================================================
# 汇川 Easy320 PLC 接入 —— 环境变量参考（复制为 .env 后修改）
# 与操作手册《PLC接入操作手册.md》第 6 章保持一致
# ============================================================

# ---------- 运行模式 ----------
# real       : 通过 Modbus TCP 采集真实 PLC（或 plc-simulator 模拟器）
# simulation : 纯模拟模式（无 PLC 参与，平台自生成数据）
PLC_MODE=real

# ---------- PLC 连接（Modbus TCP） ----------
PLC_HOST=192.168.1.88
PLC_PORT=502
PLC_UNIT_ID=1
# 采集周期 ms（真实 PLC 建议 1000-2000；配合模拟器可设 1000）
PLC_INTERVAL=2000
# 旧固件回退路径的缓冲条数（扩展协议下不生效）
PLC_WINDOW=10

# ---------- 寄存器地址（协议原地址，modbus-serial 不做 40001 偏移） ----------
# Easy320 属汇川 Easy 系列，D 区从 D0 起编址，不存在 D30001，
# 固定使用 D2001-D2022 段，与参考程序 plc-program/Easy320_main.st 一一对应。
# 三段地址必须同时正确，否则读回全 0 或数据错位：
#   主包 2001-2005 / 子包 2011-2015 / 写回 2021-2022
PLC_REG_TEMP=2001
PLC_REG_PRESS=2002
PLC_REG_HUMID=2003
PLC_REG_STATUS=2004
PLC_REG_SEQ=2005
PLC_REG_SUB_BASE=2011
PLC_REG_WRITE_FORCE=2021
PLC_REG_WRITE_HEIGHT=2022

# ---------- 接触力模型（EN 50367:2012，需现场实测标定） ----------
# F = p_air × PANTO_A_EFF − PANTO_F_OFFSET（N）
PANTO_A_EFF=0.001
PANTO_F_OFFSET=0
# 接触力目标 N（EN 50367 静态接触力 70~120N）
PANTO_F_TARGET=100

# ---------- 受电弓运动学（两连杆剪式近似 θ2 = r·θ1） ----------
PANTO_L1=1200
PANTO_L2=1300
PANTO_THETA_RATIO=0.8
PANTO_H_TARGET=2400

# ---------- 控制引擎（位置式并联 PID，微分先行） ----------
CONTROL_INTERVAL=500
# 被控对象一阶滞后时间常数 s（与模拟器一致，真实值由 Z-N 整定测定）
PANTO_TAU_FORCE=2.0
PANTO_TAU_HEIGHT=0.5
# 比例阀+管路纯滞后 ms（Z-N 拟合需要 L > 0）
PANTO_DEADTIME_MS=600

# ---------- Z-N 阶跃整定 ----------
# 阶跃幅值 = 量程 × 百分比（默认 10% = 95kPa）
ZN_STEP_PCT=10
# 阶跃响应最长等待时间 s
ZN_SETTLE_MAX_S=60
# 调试：1 时打印拟合内部过程（排错手册第 9 章用）
ZN_DEBUG=0

# ---------- 服务器 ----------
PORT=3000

# ---------- 数据库（可选；留空则平台以"无数据库模式"运行，告警只存内存） ----------
# 前置：npm install --save-dev prisma@5.22.0 && npx prisma generate && npx prisma db push
# （工程原本只装了 @prisma/client，不执行 generate 会报 PrismaClient did not initialize yet）
DATABASE_URL=mysql://rtp:你的强口令@127.0.0.1:3306/realtime_platform

# ---------- 落库口径 ----------
# 环境因素引起的预警（高温/低温/高湿）是否写入告警表；默认 false，
# 只推送前端与内存列表——环境量只作为 PID 三参数整定的过程数据，不作为告警资产。
PERSIST_ENV_WARNINGS=false
# 过程数据（温度/压力/湿度 + 双环被控量与控制输出）是否写入 sensor_sample 整定数据集
PERSIST_SAMPLES=true
# 整定数据集采样间隔（秒），避免高频刷库
SAMPLE_INTERVAL_S=10
# 告警备注最大字符数（兜底截断，防止超列宽导致整条告警丢失）
WARNING_REMARK_MAX=2000

# ---------- 演示数据 ----------
# 启动时是否补齐 6 条演示告警（见 demo-warnings.js），用于演示、截图与前端联调。
# 幂等：按备注中的 [演示数据] 标记判重，重复启动不会产生重复记录。
# 做真实采集实验时置为 false，即可回到"仅真实数据"的干净状态；
# 已写入的演示记录可用 `node tools/clear-demo-warnings.js` 一键清理。
SEED_DEMO_WARNINGS=true

# ---------- 安全与审计（v2 加固，见《平台使用操作手册》第 10 章） ----------
# 写接口令牌：非空即启用。请求需带 X-API-Token: <token> 或 Authorization: Bearer <token>
# 留空 = 不校验（默认，保持现网行为）。启用后须让前端/网关带上该请求头。
API_TOKEN=
# 每个来源 IP 每分钟允许的写请求数（令牌桶）
RATE_LIMIT_PER_MIN=120
# 审计环形缓冲条数（GET /api/v2/audit 查看）
AUDIT_LIMIT=500
# 允许的跨域来源，逗号分隔；留空 = 不限制（保持原行为）
CORS_ORIGIN=
# 置 off 关闭安全响应头（X-Content-Type-Options / Referrer-Policy）
SECURITY_HEADERS=on
# 上传扩展名白名单与单文件上限 MB（阻断 .html/.js/.svg 等可执行载荷）
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,webp,gif,bmp,mp4,webm,mov,pdf
UPLOAD_MAX_MB=50
# /api/v2/ingest 收到 major/critical 告警时是否自动生成工单
AUTO_CREATE_ORDER=true
# PID 增益允许上限（防误设导致执行机构剧烈振荡）
PID_GAIN_LIMIT=100

# ============================================================
# 以下仅 npm run plc-sim* 启动模拟器时读取（模拟 Easy320 实体机）
# ============================================================
# 模拟器从站监听地址/端口/站号（平台 .env 的 PLC_HOST/PLC_PORT/PLC_UNIT_ID 指向它）
PLC_SIM_HOST=0.0.0.0
PLC_SIM_PORT=1502
PLC_SIM_UNIT=1
# 采样周期 ms（滑窗 10 条 → 1s 出一个均值包）
PLC_SIM_INTERVAL=100
# 基准环境（正常值）
PLC_SIM_BASE_TEMP=25
PLC_SIM_BASE_PRESS=250
PLC_SIM_BASE_HUMID=45
# 异常注入：temperature:high|low, pressure:high|low, humidity:high（逗号分隔，可留空）
PLC_SIM_ANOMALY=

# ===== 1.2 工程化开关 =====
# 真实 PLC 连不上时是否允许自动回退到模拟数据。
# 生产环境（NODE_ENV=production）默认 false：宁可报链路 BAD，也不用模拟值顶替。
ALLOW_SIM_FALLBACK=true

# 安全响应头：off 可整体关闭；CSP_POLICY 可覆盖默认策略串
# SECURITY_HEADERS=on
# CSP_POLICY=default-src 'self'; script-src 'self'

# 跨域白名单：REST 与 Socket.IO 共用。留空=仅同源；配置后需列出全部实际访问地址
# 例：CORS_ORIGIN=https://pantograph.example.com,http://192.168.1.10:3000
# CORS_ORIGIN=

# sensorData 投递方式：subscribe（默认，仅订阅者收）/ broadcast（广播给所有连接，回退用）
# WS_SENSOR_MODE=subscribe

# ===== 时钟健康 =====
# NTP 服务器；不可达时自动退化为 HTTP Date（精度约 ±0.5 s）
# NTP_SERVER=ntp.aliyun.com
# CLOCK_HTTP_FALLBACK=https://www.baidu.com
# 检查间隔（分钟）与判定阈值（毫秒）
# CLOCK_CHECK_MIN=10
# CLOCK_THRESHOLD_MS=1000
# 纯内网/离线环境可整体关闭
# CLOCK_DISABLED=false

# 运行态快照路径（默认 data/runtime-state.json；测试/多实例隔离时覆盖）
# RUNTIME_STATE_FILE=./data/runtime-state.json

# ===== 认证与角色（默认关闭）=====
# 开启后：写接口需 operator 账号；未登录访问页面跳 /login
# AUTH_ENABLED=true
# AUTH_OPERATOR_USER=operator
# AUTH_OPERATOR_PASS=
# AUTH_VIEWER_USER=viewer
# AUTH_VIEWER_PASS=
# 未登录是否允许只读（false = 读也需登录）
# AUTH_PUBLIC_READ=true
# AUTH_SESSION_HOURS=8
# 签名密钥；留空则由运行态文件生成并持久化（重启不掉线）
# AUTH_SECRET=
# 走 HTTPS 时应置 true
# COOKIE_SECURE=false

# ===== 运行态快照 =====
# 每日快照目录与保留份数（默认与主文件同目录、保留 7 份）
# RUNTIME_SNAPSHOT_DIR=
# RUNTIME_SNAPSHOT_KEEP=7
